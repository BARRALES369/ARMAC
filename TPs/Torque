% Variables Definition

l = 0.4; % Length of the arm [m]
r = 0.1; % Radius [m]
theta = 60; % Angle in degrees
A = 0.01; % Cross-sectional area [m^2]
P_max=10;
P_min=1;
% theta_rad = deg2rad(theta);


L = 0.548;

thetqinput = 0 : 0.01 :2*pi ;

beta = asin((r / l) * sin(thetqinput)); %?

d = r*cos(thetqinput)+l*cos(beta);

lpthetq = L - d;

lpmin=0.048;
lpmax=0.248;

P_theta = P_max*(lpthetq/lpmin).^(-1.4);

tork = r.*cos(thetqinput).*P_theta.*A.*tan(beta) + P_theta.*A.*r.*sin(thetqinput);

